# Public site origin. Used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_BASE_URL=https://aptechibadan.com

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave blank to disable Google Analytics entirely.
# The value MUST look like a GA4 ID (G-XXXXXXXXXX) to load; anything else
# (for example a Chatbase key) is ignored.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (optional). When empty the
# verification meta tag is not rendered.
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ---------------------------------------------------------------------------
# Server-only secrets live in `.env` / deployment settings, never in this file.
# Do not commit real API keys. See `.gitignore` (`.env` is ignored).
# ---------------------------------------------------------------------------
